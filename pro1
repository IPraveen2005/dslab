#include <stdio.h>
#include <stdlib.h>
struct Node {
int data;
struct Node *next;
};
struct Node *head = NULL;
// Insert at beginning
void insert(int value) {
struct Node *newNode;
newNode = (struct Node *)malloc(sizeof(struct Node));
newNode->data = value;
newNode->next = head;
head = newNode;
}
// Delete from beginning
void deleteNode() {
struct Node *temp;
if (head == NULL) {
printf("List is empty\n");
} else {
temp = head;
head = head->next;
free(temp);
printf("Node deleted\n");
}
}
// Display linked list
void display() {
struct Node *temp = head;
if (head == NULL) {
printf("List is empty\n");
} else {
printf("Linked List: ");
while (temp != NULL) {
printf("%d -> ", temp->data);
temp = temp->next;
}
printf("NULL\n");
}
}
int main() {
insert(60);
insert(50);
insert(40);
insert(30);
insert(20);
insert(10);
display();
deleteNode();
display();
return 0;
}

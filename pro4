#include<stdio.h>
int main()
{
int n,i,j,a[10],t;
printf("enter the number");
scanf("%d",&n);
printf("enter the number one by one");
for(i=0;i<n;i++)
{
scanf("%d",&a[i]);
}
for(i=0;i<n;i++)
{
for(j=0;j<(n-1)-i;j++)
{
if(a[j]>=a[j+1])
{
t=a[j];
a[j]=a[j+1];
a[j+1]=t;
}
}
}
printf("sorting list");
for(i=0;i<n;i++)
{
printf("%d\n",a[i]);
}
}

#include<stdio.h>
int main()
{
int i,j,s,temp,a[20];
printf(" enter the total elements:");
scanf("%d",&s);
printf(" enter %d elements:",s);
for(i=0;i<s;i++)
scanf("%d",&a[i]);
for(i=1;i<s;i++)
{
temp=a[i];
j=i-1;
while(temp<a[j])
{
a[j+1]=a[j];
j=j-1;
}
a[j+1]=temp;
}
printf("After sorting:\n");
for(i=0;i<s;i++)
printf("%d\n",a[i]);
return 0;
}
